# -------------------------------------------------------
# Bootstrap config only. All other values (AWS resource names,
# service credentials, connection URIs) live in Secrets Manager.
# -------------------------------------------------------
APP_NAME=doc-analysis-app
APP_VERSION=1.1.0

# AWS — needed to bootstrap the Secrets Manager fetch
AWS_REGION=us-east-2
AWS_SECRET_NAME=doc-analysis-secret

# Logging
LOG_LEVEL=info
LOG_FORMAT=[%s] %s: [processor: %s, platform: %s@%s, app: %s@%s]: %s
