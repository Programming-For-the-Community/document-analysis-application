# -------------------------------------------------------
# Device-local config only. All AWS resource values and
# credentials are fetched from Secrets Manager at startup.
# -------------------------------------------------------

# AWS — app assumes this role at startup using your local AWS CLI credentials
AWS_REGION=us-east-2
AWS_ROLE_ARN=AWS_SERVICE_ROLE_ARN
AWS_SECRET_NAME=doc-analysis-secret

# Local Services — device-specific, not stored in Secrets Manager
NEO4J_URI=bolt://localhost:7687
QDRANT_URL=http://localhost:6333
