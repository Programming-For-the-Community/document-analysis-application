# -------------------------------------------------------
# Device-local config only. All AWS resource values and
# credentials are fetched from Secrets Manager at startup.
# -------------------------------------------------------
APP_NAME=doc-analysis-app
APP_VERSION=1.0.0


# AWS — app reads the secret with local CLI credentials, then assumes the role ARN stored in it
AWS_REGION=us-east-2
AWS_SECRET_NAME=doc-analysis-secret

# Local Services — device-specific, not stored in Secrets Manager
NEO4J_URI=bolt://localhost:7687
QDRANT_URL=http://localhost:6333

# Logging
LOG_LEVEL=debug
LOG_FORMAT=[%s] %s: [processor: %s, platform: %s@%s, app: %s@%s]: %s
